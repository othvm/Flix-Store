# Application Environment
NODE_ENV=development

# Postgres Database (e.g. Supabase, Neon, or local Postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://user:password@localhost:5432/flix_store"

# Supabase Storage & Services (Required for admin image uploads)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Authentication
# Secure access code required to authenticate to /admin
ADMIN_ACCESS_CODE="your-secure-admin-access-code"

# Admin Route Lockdown (optional: set to "true" to temporarily lock admin routes)
ADMIN_ACCESS_LOCKED="false"
